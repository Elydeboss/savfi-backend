# Django Settings
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,.onrender.com

# Database Configuration
# For Supabase:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or individual variables:
# DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# DB_NAME=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_HOST_USER=your-sendgrid-username

# CORS Configuration
# Add your frontend domain(s) here
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Optional: Redis for caching (recommended for production)
# REDIS_URL=redis://user:password@host:port

# Optional: AWS S3 for media files (recommended for production)
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: Sentry for error monitoring (recommended for production)
# SENTRY_DSN=your-sentry-dsn
